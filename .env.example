# Copy to .env (gitignored). broker/local.py and demo/user_voice.py read it.

# Voice: a Google Gemini API key. The broker sends it only to the Cloudflare AI Gateway.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/ac4054842a60a05296897e5f7042b4cd/winbestsai/compat
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Required positive admission-budget estimate; set from current Gemini audio-token pricing.
ANNIE_VOICE_USD_PER_SECOND=
# Decisions: a TypeSafe key for Jev (https://typesafe.ai). Without it, the local rule floor decides.
TYPESAFE_API_KEY=
# Optional: only used by the historical demo/audio/user_voice.py generator, not by the broker.
OPENAI_API_KEY=

# Optional broker settings (defaults in broker/annie_broker/config.py).
# ANNIE_HMAC_SECRET=            # signs session tokens; random per start when unset
# ANNIE_DAILY_BUDGET_USD=25
# ANNIE_SESSION_CAP_S=180
# ANNIE_IDLE_TIMEOUT_S=30
# ANNIE_PER_IP_DAILY=0          # local.py defaults this to 0 (no per-IP limit) for development
# ANNIE_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Optional Rosemate integration (docs/rosemate.md). Off unless URL, token and access key are all set.
# The token stays on the broker: never put it in the URL (?token= is refused), the stage or a commit.
# Rotate it if it has ever been shared in a chat, issue or log.
ANNIE_ROSEMATE_MCP_URL=https://rosemate.winbests.net/rosemate/mcp
ANNIE_ROSEMATE_MCP_TOKEN=
# Shared key (>= 16 chars) that stage users type to open an integration session.
ANNIE_ROSEMATE_ACCESS_KEY=
# 1 = allow outbound toy actions (users must still opt in on the stage). Stop is always allowed.
ANNIE_ROSEMATE_TOY_ACTIONS=0
# 1 = mailbox poll fallback. It CONSUMES commands and can take them from the Rosemate PWA; keep 0.
ANNIE_ROSEMATE_POLL=0
